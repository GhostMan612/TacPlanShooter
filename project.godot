; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TacPlan Shooter"
run/main_scene="res://scenes/splash.tscn"
config/version="1.0.0"
config/quit_on_go_back=false

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
SimClock="*res://scripts/autoload/sim_clock.gd"
TacticalAudio="*res://scripts/audio/tactical_audio.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=486
window/size/window_height_override=864
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_pan={
"deadzone": 0.2,
"events": []
}
ui_pinch_zoom={
"deadzone": 0.2,
"events": []
}
operative_longpress={
"deadzone": 0.2,
"events": []
}
node_tap={
"deadzone": 0.2,
"events": []
}
commit_plan={
"deadzone": 0.2,
"events": []
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
